{
	
    // 全局 bar 设置
    "layer": "top",                 // 显示在顶层，不会被窗口遮挡
    "position": "top",             // top 顶栏 / bottom 底栏
    "height": 30,                  // 栏高度，单位像素
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    // 如果你想 bar 和屏幕边缘之间有间距，可以给 margin 设置值，比如 "margin-top": 10

    // 三个区域模块：left / center / right
    "modules-left": ["niri/workspaces"],
    "modules-center": ["cava","custom/date","custom/arch","clock","custom/network"],
//	"modules-center": ["custom/arch"],
    "modules-right": ["tray"],
	"fixed-center": true,
    // 模块详细定义
    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": false
    },

    "custom/date": {
        "exec": "date '+%y-%-m-%-d'",
        "interval": 60,
        "format": "{}"
    },

	"custom/arch":{
		"format": "",
		"on-click": "kitty -e zsh -c 'fastfetch;exec zsh' ",
		"on-click-right": "fuzzel",
		"tooltip": "Arch Linux",
		"align": "center"

	},
    "clock": {
        "format": "{0:%H:%M}",
        "tooltip-format": "<big>{0:%Y %B}</big>\n<tt><small>{0:%A, %d %b %Y}</small></tt>"
    },

    "custom/network": {
        "exec": "~/.config/waybar/network-speed.sh",
        "interval": 2,
        "format": "{}"
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
 "cava": {
        // "cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
        "framerate": 30,
        "autosens": 0,
        "sensitivity": 1,
        "bars": 18,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "hide_on_silence": false,
        // "format_silent": "quiet",
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.77,
        "input_delay": 0,
        "format-icons": [" "," ","▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
                   "on-click-right": "mode"
                   }
    }
}

